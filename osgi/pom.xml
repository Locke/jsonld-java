<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<parent>
		<groupId>com.github.jsonld-java</groupId>
		<artifactId>jsonld-java-parent</artifactId>
		<version>${revision}</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>jsonld-java-osgi</artifactId>
	<name>JSONLD Java :: OSGi</name>
	<description>Json-LD OSGi packaging</description>
	<packaging>bundle</packaging>

	<dependencies>

		<!-- START inter-module dependencies -->

		<dependency>
			<groupId>com.github.jsonld-java</groupId>
			<artifactId>jsonld-java</artifactId>
		</dependency>

		<!-- END inter-module dependencies -->


		<!-- START module-specific dependencies -->

		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient-osgi</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpcore-osgi</artifactId>
		</dependency>

		<!-- END module-specific dependencies -->

	</dependencies>
	<build>
		<plugins>
			<!-- Shade Google Guava into jsonld-java to avoid downstream incompatibilities 
				caused by Guava's fast major release cycles. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<configuration>
					<artifactSet>
						<includes>
							<include>com.google.guava:guava</include>
							<include>com.google.guava:failureaccess</include>
						</includes>
					</artifactSet>
					<relocations>
						<relocation>
							<pattern>com.google.common</pattern>
							<shadedPattern>com.github.jsonldjava.shaded.com.google.common</shadedPattern>
						</relocation>
						<relocation>
							<pattern>com.google.thirdparty</pattern>
							<shadedPattern>com.github.jsonldjava.shaded.com.google.thirdparty</shadedPattern>
						</relocation>
					</relocations>
					<filters>
						<filter>
							<artifact>com.google.guava:guava</artifact>
							<excludes>
								<exclude>META-INF/maven/**</exclude>
							</excludes>
						</filter>
						<filter>
							<artifact>com.google.guava:failureaccess</artifact>
							<excludes>
								<exclude>META-INF/maven/**</exclude>
							</excludes>
						</filter>
					</filters>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<instructions>
						<Import-Package>
							!com.google.common.*,
							org.slf4j.*; version="[1.0.0,2)",
							*
						</Import-Package>
					</instructions>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>

